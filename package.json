{
  "name": "opencode-retitle",
  "version": "0.3.2",
  "description": "Keep OpenCode session titles meaningful: regenerate them after N turns, after compaction, and after the first response in a forked session.",
  "type": "module",
  "license": "MIT",
  "author": "Cardin Lee",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cardin/opencode-retitle.git"
  },
  "homepage": "https://github.com/cardin/opencode-retitle#readme",
  "bugs": {
    "url": "https://github.com/cardin/opencode-retitle/issues"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "session",
    "title"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./rpc": "./src/rpc.ts",
    "./tui": "./src/tui.ts"
  },
  "files": [
    "src",
    "docs",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test test/config.test.ts test/guard.test.ts test/state.test.ts test/titles.test.ts test/retitle.test.ts test/tui.test.ts",
    "test:integration": "node --test test/integration.test.ts",
    "test:all": "node --test test/*.test.ts",
    "prepublishOnly": "npm run typecheck && npm run test:all"
  },
  "dependencies": {
    "@opencode/plugin": "^2.2.3"
  },
  "peerDependencies": {
    "@opencode/theme": ">=2.2.3",
    "@opentui/core": ">=0.8.0",
    "@opentui/solid": ">=0.8.0",
    "solid-js": ">=1.9.0"
  },
  "peerDependenciesMeta": {
    "@opencode/theme": {
      "optional": true
    },
    "@opentui/core": {
      "optional": true
    },
    "@opentui/solid": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "solid-js": "^1.9.0",
    "typescript": "^5.9.0"
  }
}
